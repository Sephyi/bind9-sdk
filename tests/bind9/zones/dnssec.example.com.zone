$ORIGIN dnssec.example.com.
$TTL 3600
@   IN  SOA  ns1.dnssec.example.com. admin.dnssec.example.com. (
            2026031701 ; serial
            3600       ; refresh
            900        ; retry
            604800     ; expire
            86400      ; minimum
        )
@       IN  NS   ns1.dnssec.example.com.
ns1     IN  A    127.0.0.1
www     IN  A    192.0.2.10
mail    IN  MX   10 mail.dnssec.example.com.
mail    IN  A    192.0.2.20
