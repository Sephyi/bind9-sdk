# --- Rust / Cargo ------------------------------------------------------------

# Cargo build artifacts
debug/
target/
dist/

# napi-rs build output (scoped to bindings crate)
crates/bind9-sdk-bindings/*.node
crates/bind9-sdk-bindings/index.js
crates/bind9-sdk-bindings/index.d.ts
crates/bind9-sdk-bindings/browser.js
crates/bind9-sdk-bindings/*.wasm
crates/bind9-sdk-bindings/*.wasi.cjs
crates/bind9-sdk-bindings/*.wasi-browser.js
crates/bind9-sdk-bindings/wasi-worker*.mjs

# Rust backup files (rustfmt)
**/*.rs.bk

# MSVC debug information
*.pdb

# Mutation testing data
**/mutants.out*/

# --- Node --------------------------------------------------------------------

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

