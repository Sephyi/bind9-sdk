# Pre-commit hook: verify all Rust files are formatted.
# Install with: git config core.hooksPath .githooks

set -euo pipefail

if ! cargo fmt --all --check 2>/dev/null; then
    echo ""
    echo "ERROR: Rust formatting check failed."
    echo "Run 'cargo fmt --all' to fix, then stage the changes and retry."
    echo ""
    exit 1
fi
